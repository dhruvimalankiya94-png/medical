PORT=5001
MONGO_URI=mongodb://localhost:27017/smart_healthcare
JWT_SECRET=smart_healthcare_jwt_secret_key_2026
JWT_EXPIRE=7d
ML_SERVICE_URL=http://127.0.0.1:8000

# Base URL of the frontend, used to build the password reset link in emails.
CLIENT_URL=http://localhost:3000

# Outbound email (password reset).
# Leave these unset for local development: the app then delivers to a
# disposable capture inbox and returns a previewUrl that opens the rendered
# message in a browser. Set all three to send through a real SMTP account
# (for Gmail, use an App Password rather than the account password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_address@gmail.com
# SMTP_PASS=your_app_password
# MAIL_FROM=HealthPulse <no-reply@healthpulse.local>

# Database used by the Jest test suite. Defaults to mongodb://127.0.0.1:27017
# and creates/drops its own healthpulse_test_* database, so it never touches
# the development data above.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017
